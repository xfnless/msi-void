# Normal interactive lf configuration. Portal selection uses dedicated configs.
set shell sh
set shellopts '-eu'
set ifs "\n"

set preview
set previewer ~/.config/lf/preview
set hidden
set ignorecase
set smartcase
set info size:time
set dircounts
set infotimefmtnew "01-02 15:04"
set infotimefmtold "2006-01-02"
set timefmt "2006-01-02 15:04:05"
set scrolloff 3
set mouse
set period 1

# Keep download folders ordered with the newest files first.
setlocal /home/xfn/Downloads sortby time
setlocal /home/xfn/Downloads reverse
setlocal "/home/xfn/Downloads/Telegram Desktop" sortby time
setlocal "/home/xfn/Downloads/Telegram Desktop" reverse

cmd open ${{
	set -f
	if [ -d "$f" ]; then
		escaped=$(printf '%s' "$f" | sed 's/\\/\\\\/g;s/"/\\"/g')
		lf -remote "send $id cd \"$escaped\""
		exit 0
	fi
	case $(file --mime-type -Lb -- "$f") in
	text/*|application/json|application/xml|application/javascript|\
	application/x-sh|application/x-shellscript|application/x-zerosize|inode/x-empty)
		vis -- $fx
		;;
	image/*)
		lf-detach imv -- $fx
		;;
	video/*|audio/*)
		lf-detach mpv -- $fx
		;;
	application/pdf)
		lf-detach zathura -- $fx
		;;
	*)
		for path in $fx; do
			lf-detach xdg-open "$path"
		done
		;;
	esac
}}

map l open
map <right> open
map <enter> open
map a :push %touch<space>
map A :push %mkdir<space>

cmd trash ${{
	set -f
	gio trash -- $fx
}}
map D trash

cmd copy_path ${{
	set -f
	printf '%s\n' $fx | wl-copy
}}
map gp copy_path

cmd copy_name ${{
	set -f
	for path in $fx; do
		basename -- "$path"
	done | wl-copy
}}
map gn copy_name

cmd dir_size %{{
	set -f
	[ -d "$f" ] || { printf 'not a directory: %s\n' "$f"; exit 1; }
	size=$(du -sh -- "$f" | cut -f1)
	printf '目录大小: %s\n' "$size"
}}
map zd dir_size

cmd fzf_jump ${{
	set -f
	target=$(fd --type f --type d --hidden --follow --exclude .git 2>/dev/null | fzf) || exit 0
	[ -n "$target" ] || exit 0
	target=$(realpath -- "$target")
	escaped=$(printf '%s' "$target" | sed 's/\\/\\\\/g;s/"/\\"/g')
	lf -remote "send $id select \"$escaped\""
}}
map <c-f> fzf_jump

cmd fzf_rg ${{
	set -f
	pattern=$1
	[ -n "$pattern" ] || exit 0
	target=$(rg -l --hidden --glob '!.git' -- "$pattern" 2>/dev/null | fzf \
		--preview "rg -n --color=always -- \"$pattern\" {} 2>/dev/null | head -100") || exit 0
	[ -n "$target" ] || exit 0
	target=$(realpath -- "$target")
	escaped=$(printf '%s' "$target" | sed 's/\\/\\\\/g;s/"/\\"/g')
	lf -remote "send $id select \"$escaped\""
}}
map <c-g> :push :fzf_rg<space>

cmd extract ${{
	set -f
	case $f in
	*.tar.bz|*.tar.bz2|*.tbz|*.tbz2) tar xjvf "$f" ;;
	*.tar.gz|*.tgz) tar xzvf "$f" ;;
	*.tar.xz|*.txz) tar xJvf "$f" ;;
	*.zip) unzip "$f" ;;
	*.7z) 7z x "$f" ;;
	*) printf 'unknown archive: %s\n' "$f" ;;
	esac
}}

cmd tar ${{
	set -f
	[ -n "${1:-}" ] || { printf 'archive name required\n' >&2; exit 2; }
	lf-archive tar "$1.tar.gz" $fx
}}

cmd zip ${{
	set -f
	[ -n "${1:-}" ] || { printf 'archive name required\n' >&2; exit 2; }
	lf-archive zip "$1.zip" $fx
}}

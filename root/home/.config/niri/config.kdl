// 本文件保存在 voidlinux-config 仓库，通过符号链接作为 Niri 的实际配置。

input {
    keyboard { repeat-delay 200; repeat-rate 30; }
    touchpad {
        tap
        dwt
        dwtp
        natural-scroll
        scroll-method "two-finger"
        scroll-factor 0.85
        accel-profile "adaptive"
        accel-speed 0.2
        tap-button-map "left-right-middle"
        click-method "clickfinger"
        drag true
        drag-lock
    }
    focus-follows-mouse max-scroll-amount="0%"
    workspace-auto-back-and-forth
    mouse { accel-speed 0.2; }
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

// 默认让 Niri 根据连接的输出自动选择 DRM 设备，不固定 render node。

layout {
    preset-column-widths { proportion 0.382; proportion 0.618; proportion 1.0;}
    default-column-width { proportion 0.618; }
    background-color "transparent"
    always-center-single-column
    gaps 0
    focus-ring {        off;}
    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        draw-behind-window true
        color "#000000ff"
        inactive-color "#00000054"
    }
}
prefer-no-csd
hotkey-overlay { skip-at-startup; }
window-rule { open-floating false; }

// xdg-desktop-portal-termfilechooser 使用这个标题启动 Alacritty。
window-rule {
    match app-id="^Alacritty$" title="^termfilechooser$"
    open-floating true
    open-focused true
    default-column-width { proportion 0.8; }
    default-window-height { proportion 0.8; }
}

// 两台内屏都使用精确 EDID 型号，避免连接器名称变化或相互覆盖。
output "AU Optronics 0x0FA7 Unknown" {
       scale 1.5
       mode "2560x1600@60.003"
}

output "Tianma Microelectronics Ltd. TL140ADMP01 Unknown" {
       scale 1.5
       mode "2560x1600@60.000"
}

// Put swaybg inside the overview backdrop.
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

gestures { hot-corners { off; };}
animations { off ;}

// Niri 由 `dbus-run-session niri --session` 启动。
// --session 会自行把 WAYLAND_DISPLAY 导入会话 D-Bus，这里不再重复调用
// dbus-update-activation-environment。
// swaybg 用 exec 替换临时 shell，使 $HOME 能展开且不留下常驻 sh。
// swayidle 会用 shell 执行 timeout 命令，因此其中的 $HOME 会在锁屏时展开。
spawn-at-startup "sh" "-c" "exec swaybg -i \"$HOME/.config/niri/bg.jpg\""
spawn-at-startup "swayidle" "-w" \
    "timeout" "180" "swaylock -f -i $HOME/.config/niri/lock.jpg" \
    "timeout" "240" "niri msg action power-off-monitors"
spawn-at-startup "fcitx5"
spawn-at-startup "pipewire"
spawn-at-startup "alacritty"
spawn-at-startup "wlsunset" "-l" "20" "-L" "100"
spawn-at-startup "mouseless"

binds {
Mod+escape repeat=false { power-off-monitors; }
Mod+a repeat=false { spawn "alacritty"; }
Mod+c repeat=false { spawn "helium" "--new-window"; }
Mod+shift+c repeat=false { spawn "firefox" "--new-window"; }
Mod+ctrl+c repeat=false { spawn "google-chrome-stable" "--new-window"; }
Mod+z repeat=false { spawn "Telegram"; }
Mod+v repeat=false { toggle-overview; }
Mod+p repeat=false { spawn-sh "grim - | swappy -f -"; }
Mod+shift+p repeat=false { spawn-sh "grim -g \"$(slurp)\" - | swappy -f -"; }
Mod+r repeat=false { switch-preset-column-width; }

Mod+s  cooldown-ms=70   { focus-column-left; }
Mod+f  cooldown-ms=70   { focus-column-right; }
Mod+e  cooldown-ms=70   { focus-window-or-workspace-up; }
Mod+d  cooldown-ms=70  { focus-window-or-workspace-down; }
Mod+shift+s cooldown-ms=70    { move-column-left; }
Mod+shift+f cooldown-ms=70    { move-column-right; }
Mod+shift+e cooldown-ms=70 { move-window-up-or-to-workspace-up; }
Mod+shift+d cooldown-ms=70 { move-window-down-or-to-workspace-down; }

Mod+alt+e cooldown-ms=70 { move-column-to-workspace-up; }
Mod+alt+d cooldown-ms=70 { move-column-to-workspace-down; }

Mod+alt+s cooldown-ms=70 { consume-or-expel-window-left; }
Mod+alt+f cooldown-ms=70 { consume-or-expel-window-right; }

XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "2%-"; }
XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "2%+"; }
XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "2%-"; }
XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "2%+"; }
XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

Mod+WheelScrollDown cooldown-ms=70 { focus-workspace-down; }
Mod+WheelScrollUp   cooldown-ms=70 { focus-workspace-up; }
Mod+MouseRight  { focus-column-right; }
Mod+MouseLeft  { focus-column-left; }
}

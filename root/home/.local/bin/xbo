#!/usr/bin/env bash
# 孤儿包 → fzf 多选删除（按包名，不查 install-date）
set -euo pipefail

xbps-query -O | sed 's/-[0-9].*//' |
	sort -u |
	awk '{print $0 "\t" $0}' |
	fzf -q "${*:-}" --multi \
		--bind='ctrl-a:toggle-all' \
		--delimiter=$'\t' \
		--with-nth=1 \
		--header='孤儿包；Tab 多选，Ctrl-A 全选/取消' \
		--preview-window='right,60%,wrap' \
		--preview 'xbps-query {2}' |
	awk -F '\t' '{print $2}' |
	xargs -r -o sudo xbps-remove -R

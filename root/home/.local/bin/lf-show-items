#!/usr/bin/env python3
"""Expose lf through org.freedesktop.FileManager1.ShowItems."""

import subprocess
import sys
from pathlib import Path
from urllib.parse import unquote, urlparse


def uri_to_path(uri: str) -> str:
    parsed = urlparse(uri)
    if parsed.scheme != "file" or parsed.netloc not in ("", "localhost"):
        raise ValueError(f"unsupported URI: {uri}")
    return unquote(parsed.path)


def show_items(uris: list[str]) -> None:
    for uri in uris:
        path = uri_to_path(uri)
        title = f"lf: {path}"
        subprocess.Popen(
            ["setsid", "-f", "alacritty", "--title", title, "-e", "lf", "-single", path],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )


def serve() -> None:
    import dbus
    import dbus.service
    from dbus.mainloop.glib import DBusGMainLoop
    from gi.repository import GLib

    DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    name = dbus.service.BusName("org.freedesktop.FileManager1", bus=bus)

    class FileManager(dbus.service.Object):
        @dbus.service.method("org.freedesktop.FileManager1", in_signature="ass", out_signature="")
        def ShowItems(self, uris, startup_id):
            del startup_id
            show_items(list(uris))

        @dbus.service.method("org.freedesktop.FileManager1", in_signature="ass", out_signature="")
        def ShowFolders(self, uris, startup_id):
            del startup_id
            show_items(list(uris))

        @dbus.service.method("org.freedesktop.FileManager1", in_signature="ass", out_signature="")
        def ShowItemProperties(self, uris, startup_id):
            del uris, startup_id

    manager = FileManager(bus, "/org/freedesktop/FileManager1")
    loop = GLib.MainLoop()
    try:
        loop.run()
    finally:
        manager.remove_from_connection()
        del name


def main() -> None:
    if sys.argv[1:] == ["--service"]:
        serve()
    elif len(sys.argv) > 1:
        show_items(sys.argv[1:])
    else:
        raise SystemExit(f"usage: {Path(sys.argv[0]).name} --service | FILE_URI...")


if __name__ == "__main__":
    main()

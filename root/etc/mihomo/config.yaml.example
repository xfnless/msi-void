mixed-port: 7890
external-controller: 127.0.0.1:9090
allow-lan: false
mode: rule
log-level: warning
ipv6: false
find-process-mode: always

profile:
  store-selected: true

tun:
  enable: true
  stack: system
  dns-hijack: [any:53]
  auto-route: true
  auto-detect-interface: true

dns:
  enable: true
  enhanced-mode: fake-ip
  default-nameserver:
    - 1.1.1.1
  nameserver:
    - https://1.1.1.1/dns-query

# REPLACE_STATIC_NODE_VALUES: paste the two complete Mihomo proxy mappings here,
# then remove this marker before running 45-mihomo.sh again.
proxies:
  - name: 香港节点
    type: vless
    server: REPLACE_HK_SERVER
    port: 8443
    uuid: 00000000-0000-0000-0000-000000000000
    network: tcp
  - name: 国内节点
    type: vless
    server: REPLACE_CN_RELAY_SERVER
    port: 9443
    uuid: 00000000-0000-0000-0000-000000000000
    network: tcp

proxy-groups:
  - name: 香港
    type: select
    proxies: [香港节点]
  - name: 国内
    type: select
    proxies: [国内节点]
  - name: GLOBAL
    type: select
    proxies: [香港, 国内, DIRECT, 香港节点, 国内节点]

rules:
  - AND,((OR,((PROCESS-NAME,firefox),(PROCESS-NAME,chrome),(PROCESS-NAME,Telegram))),(GEOSITE,category-ads-all)),REJECT
  - SUB-RULE,(PROCESS-NAME,firefox),work-app
  - SUB-RULE,(PROCESS-NAME,chrome),work-app
  - SUB-RULE,(PROCESS-NAME,Telegram),work-app
  - MATCH,DIRECT

sub-rules:
  work-app:
    - GEOSITE,private,DIRECT
    - GEOIP,private,DIRECT,no-resolve
    - GEOSITE,cn,国内
    - GEOIP,cn,国内,no-resolve
    - MATCH,香港

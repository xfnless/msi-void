mixed-port: 7890
external-controller: 127.0.0.1:9090
allow-lan: false
mode: rule
log-level: warning
ipv6: false
find-process-mode: always

profile:
  store-selected: true

tun:
  enable: true
  stack: system
  dns-hijack: [any:53]
  auto-route: true
  auto-detect-interface: true

dns:
  enable: true
  enhanced-mode: fake-ip
  default-nameserver:
    - 1.1.1.1
  nameserver:
    - https://1.1.1.1/dns-query

proxy-providers:
  marzban:
    type: http
    url: MARZBAN_SUBSCRIPTION_URL
    path: ./providers/marzban.yaml
    interval: 21600
    header:
      User-Agent: [mihomo]
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 600

proxy-groups:
  - name: 香港
    type: select
    use: [marzban]
    filter: '(?i)(香港|8443|\bHK\b|Hong[ -]?Kong)'
  - name: 国内
    type: select
    use: [marzban]
    filter: '(?i)(国内|9443|hk-gz|\bCN\b|China)'
  - name: GLOBAL
    type: select
    proxies: [香港, 国内, DIRECT]
    use: [marzban]

rules:
  - AND,((OR,((PROCESS-NAME,firefox),(PROCESS-NAME,chrome),(PROCESS-NAME,Telegram))),(GEOSITE,category-ads-all)),REJECT
  - SUB-RULE,(PROCESS-NAME,firefox),work-app
  - SUB-RULE,(PROCESS-NAME,chrome),work-app
  - SUB-RULE,(PROCESS-NAME,Telegram),work-app
  - MATCH,DIRECT

sub-rules:
  work-app:
    - GEOSITE,private,DIRECT
    - GEOIP,private,DIRECT,no-resolve
    - GEOSITE,cn,国内
    - GEOIP,cn,国内,no-resolve
    - MATCH,香港

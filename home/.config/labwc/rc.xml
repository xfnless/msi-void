<labwc_config>
  <theme>
    <font name="WenQuanYi Micro Hei" size="10" />
  </theme>

  <keyboard>
    <default />
    <repeatRate>40</repeatRate>
    <repeatDelay>250</repeatDelay>
    <keybind key="W-Return">
      <action name="Execute" command="alacritty" />
    </keybind>
    <keybind key="W-p">
      <action name="Execute" command="bemenu-run -i --fn &apos;WenQuanYi Micro Hei 14&apos;" />
    </keybind>
  </keyboard>

  <libinput>
    <device category="touchpad">
      <tap>yes</tap>
    </device>
  </libinput>
</labwc_config>

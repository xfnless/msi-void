# tri — shared by session.sh and the WM binary.
# Copy or symlink to ~/.config/tri/config to override.

master_ratio = 0.62
cursor_size = 28
cursor_theme = Adwaita

output = eDP-1
mode = 2560x1600@60Hz
scale = 1.5

env.GTK_IM_MODULE =
env.QT_IM_MODULE = fcitx
env.QT_IM_MODULES = wayland;fcitx
env.XMODIFIERS = @im=fcitx

# Session startup, in file order. Labels are only for readability.
start.portal_filechooser = test ! -x /usr/libexec/xdg-desktop-portal-termfilechooser || exec /usr/libexec/xdg-desktop-portal-termfilechooser
start.portal = sleep 0.2; test ! -x /usr/libexec/xdg-desktop-portal || exec /usr/libexec/xdg-desktop-portal
start.input_method = exec fcitx5
start.audio = exec pipewire
start.sunset = exec wlsunset -l 20 -L 100
start.mouse = exec mouseless
start.terminal = exec alacritty
start.idle = exec swayidle -w timeout 180 "swaylock -f -i $HOME/.config/niri/bg3.jpg" timeout 240 "wlopm --off '*'" resume "wlopm --on '*'"

# Keyboard: bind.<key> = shell command, or :tri_internal_action.
# Modifiers: Super, Ctrl, Shift, Alt. Delete a line to disable it.
bind.Super+a = exec alacritty
bind.Super+c = exec helium
bind.Super+v = exec alacritty -e vis "$HOME/Drafts/memo/inbox.md"
bind.Super+w = grim - | satty -f - --copy-command wl-copy --early-exit copy
bind.Super+Escape = wlopm --toggle '*'

bind.XF86MonBrightnessUp = brightnessctl set 2%+
bind.XF86MonBrightnessDown = brightnessctl set 2%-
bind.XF86AudioRaiseVolume = wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+
bind.XF86AudioLowerVolume = wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-
bind.XF86AudioMute = wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

bind.Super+Shift+q = :close
bind.Super+Ctrl+Shift+q = :exit
bind.Super+s = :focus_toggle
bind.Super+e = :expand_prev
bind.Super+d = :expand_next
bind.Super+Shift+s = :swap
bind.Super+Shift+e = :move_expand_prev
bind.Super+Shift+d = :move_expand_next
bind.Super+f = :fill_screen
bind.Super+r = :flip_ratio
bind.Super+Shift+r = :flip_columns

bind.Super+1 = :expand_slot_1
bind.Super+2 = :expand_slot_2
bind.Super+3 = :expand_slot_3
bind.Super+4 = :expand_slot_4
bind.Super+5 = :expand_slot_5
bind.Super+6 = :expand_slot_6
bind.Super+7 = :expand_slot_7
bind.Super+8 = :expand_slot_8
bind.Super+9 = :expand_slot_9
bind.Super+Shift+1 = :move_slot_1
bind.Super+Shift+2 = :move_slot_2
bind.Super+Shift+3 = :move_slot_3
bind.Super+Shift+4 = :move_slot_4
bind.Super+Shift+5 = :move_slot_5
bind.Super+Shift+6 = :move_slot_6
bind.Super+Shift+7 = :move_slot_7
bind.Super+Shift+8 = :move_slot_8
bind.Super+Shift+9 = :move_slot_9

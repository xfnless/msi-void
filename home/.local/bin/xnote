#!/usr/bin/env bash
# 浮动便签：跨工作区 sticky（需 niri-float-sticky 守护进程）
# 再按一次：已聚焦则关闭，存在则聚焦，否则打开
set -euo pipefail

note=${XNOTE_FILE:-$HOME/.local/share/sticky/note.md}
mkdir -p "$(dirname "$note")"
[[ -f $note ]] || : >"$note"

info=$(
	niri msg -j windows | python3 -c '
import json, sys
for w in json.load(sys.stdin):
    if w.get("title") == "sticky-note":
        print(w["id"], 1 if w.get("is_focused") else 0)
        break
'
)

if [[ -n $info ]]; then
	id=${info%% *}
	focused=${info##* }
	if [[ $focused -eq 1 ]]; then
		niri msg action close-window --id "$id"
	else
		niri msg action focus-window --id "$id"
	fi
	exit 0
fi

exec alacritty \
	--title sticky-note \
	-o window.dynamic_title=false \
	-e vis "$note"

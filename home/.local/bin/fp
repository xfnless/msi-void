#!/usr/bin/env bash
set -euo pipefail

BASE="${XDG_DATA_HOME:-$HOME/.local/share}/fp"

mkdir -p "$BASE"

safe_name() {
    printf '%s\n' "$1" | sed 's/[^a-zA-Z0-9._@+-]/_/g'
}

require_command() {
    local command_name="$1"

    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "缺少命令: $command_name" >&2
        return 1
    fi
}

edit_file() {
    local file="$1"
    local editor_value="${EDITOR:-}"
    local candidate
    local editor_command=()

    if [ -n "$editor_value" ]; then
        read -r -a editor_command <<< "$editor_value"
    else
        for candidate in vis vi nano; do
            if command -v "$candidate" >/dev/null 2>&1; then
                editor_command=("$candidate")
                break
            fi
        done
    fi

    if [ "${#editor_command[@]}" -eq 0 ] ||
        ! command -v "${editor_command[0]}" >/dev/null 2>&1; then
        echo "没有可用编辑器；请设置 EDITOR 后重试" >&2
        return 1
    fi

    "${editor_command[@]}" "$file"
}

read_urls() {
    local url_file="$1"

    grep -v '^[[:space:]]*$' "$url_file" |
        grep -v '^[[:space:]]*#' || true
}

add_profile() {
    local provider="$1"
    local account="$2"
    local safe_provider
    local safe_account
    local provider_path
    local profile_path
    local url_file

    safe_provider="$(safe_name "$provider")"
    safe_account="$(safe_name "$account")"
    provider_path="$BASE/$safe_provider"
    profile_path="$provider_path/$safe_account"
    url_file="$provider_path/.url"

    if [ -d "$profile_path" ]; then
        echo "profile 已存在: $safe_provider / $safe_account"
    else
        mkdir -p "$profile_path"
        echo "已添加 profile: $safe_provider / $safe_account"
    fi

    if [ ! -f "$url_file" ]; then
        echo "没有 .url，正在打开编辑器:"
        echo "  $url_file"
        edit_file "$url_file"
        return
    fi

    echo "已有 .url:"
    echo "  $url_file"

    if read_urls "$url_file" | grep -q .; then
        echo "当前 URL:"
        read_urls "$url_file" | sed 's/^/  /'
    else
        echo ".url 文件为空，正在打开编辑器:"
        echo "  $url_file"
        edit_file "$url_file"
    fi
}

list_profiles() {
    find "$BASE" -mindepth 2 -maxdepth 2 -type d -printf '%P\n' |
        sort |
        awk -F '/' '{ print $1 "\t" $2 }'
}

open_profile() {
    local provider="$1"
    local account="$2"
    local profile_path="$BASE/$provider/$account"
    local url_file="$BASE/$provider/.url"
    local urls=()

    require_command firefox

    if [ ! -d "$profile_path" ]; then
        echo "profile 不存在: $provider / $account" >&2
        return 1
    fi

    if [ ! -f "$url_file" ]; then
        echo "没有 .url 文件: $url_file" >&2
        echo "请先执行: fp add $provider $account" >&2
        return 1
    fi

    mapfile -t urls < <(read_urls "$url_file")

    if [ "${#urls[@]}" -eq 0 ]; then
        echo ".url 文件为空: $url_file" >&2
        echo "请先执行: fp add $provider $account" >&2
        return 1
    fi

    firefox --new-instance --profile "$profile_path" "${urls[@]}" \
        >/dev/null 2>&1 &
}

choose_and_open() {
    local provider_filter="${1:-}"
    local lines

    require_command fzf

    if [ -n "$provider_filter" ]; then
        provider_filter="$(safe_name "$provider_filter")"
        lines="$(
            list_profiles |
                awk -F '\t' -v p="$provider_filter" '$1 == p' |
                fzf --multi --delimiter='\t' --with-nth=1,2 \
                    --prompt="$provider_filter > "
        )"
    else
        lines="$(
            list_profiles |
                fzf --multi --delimiter='\t' --with-nth=1,2 --prompt='fp > '
        )"
    fi

    [ -z "${lines:-}" ] && exit 0

    while IFS=$'\t' read -r provider account; do
        [ -z "${provider:-}" ] && continue
        open_profile "$provider" "$account" || true
        sleep 0.3
    done <<< "$lines"
}

open_all() {
    local provider_filter="${1:-}"

    [ -n "$provider_filter" ] && provider_filter="$(safe_name "$provider_filter")"

    while IFS=$'\t' read -r provider account; do
        [ -z "${provider:-}" ] && continue

        if [ -n "$provider_filter" ] && [ "$provider" != "$provider_filter" ]; then
            continue
        fi

        open_profile "$provider" "$account" || true
        sleep 0.3
    done < <(list_profiles)
}

case "${1:-}" in
    add)
        provider="${2:-}"
        account="${3:-}"

        if [ -z "$provider" ] || [ -z "$account" ]; then
            echo "用法: fp add 文件夹 profile名"
            echo "例子: fp add ctyun account-name"
            exit 1
        fi

        add_profile "$provider" "$account"
        ;;
    all)
        open_all "${2:-}"
        ;;
    list | ls)
        list_profiles
        ;;
    *)
        choose_and_open "${1:-}"
        ;;
esac
